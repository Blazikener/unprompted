ORIANE_API_KEY=
# Shared daily Oriane credit budget across Receipts, brands, digests, and prospecting (default 600)
# ORIANE_DAILY_BUDGET=600
# Optional
# DATABASE_URL=postgresql:///unprompted
# HOST=127.0.0.1
# PORT=8000

# Receipts (creator product at /creators/)
# DEMO_MODE=1               # force fixture creators (@maya.eats, @sami.lifts); also on whenever ORIANE_API_KEY is empty
# APP_URL=http://127.0.0.1:8000
# STRIPE_SECRET_KEY=        # billing is disabled until all three Stripe vars are set
# STRIPE_PRICE_PRO=         # price id for the $29/mo Pro subscription
# STRIPE_WEBHOOK_SECRET=
# DEV_PLAN_SWITCH=1         # local only: lets a signed-in user flip free<->pro without Stripe

# Weekly digest (brand side at /brands/, "Email me weekly"; Oriane Community Tool)
# DIGEST_MAX_ACTIVE=25      # maximum confirmed, unpaused digests site-wide
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
# MAIL_RELAY_URL + MAIL_RELAY_SECRET take priority over Resend
# RESEND_API_KEY=           # fallback provider when MAIL_RELAY_* is not configured
# DIGEST_FROM=Unprompted <digest@yourdomain.com>
# LICENSE_NOTIFY_EMAIL=you@yourdomain.com  # gets each "License for ads" request from the weekly report, to broker by hand
# DIGEST_RUN_TOKEN=         # enables POST /api/digests/run (Authorization: Bearer <token>) for a cron / manual run
# DIGEST_SCHEDULER=1        # in-process run of due digests every 15 min (one Oriane search per digest per week)
